{
  "name": "serper-search-mcp",
  "version": "4.0.0",
  "description": "MCP server for Serper API — Google web, image, video, news, shopping, and places search for AI agents",
  "main": "index.js",
  "bin": {
    "serper-search-mcp": "index.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "check:bundle": "node scripts/bundle.mjs --check",
    "pretest": "npm run build",
    "test": "node --test",
    "start": "node index.js",
    "dev": "npm run bundle && node index.js",
    "http": "node index.js --transport http",
    "docker:build": "docker build -t smjahid/server-serper-search .",
    "docker:run": "docker run -i --rm -e SERPER_API_KEY smjahid/server-serper-search",
    "help": "node index.js --help",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build && npm run bundle",
    "prepublishOnly": "npm run rebuild && npm run check:bundle && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "serper",
    "google-search",
    "search",
    "web-search",
    "image-search",
    "news-search",
    "video-search",
    "shopping-search",
    "places-search",
    "google-maps",
    "ai-agent",
    "llm-tools",
    "claude",
    "cursor",
    "anthropic",
    "smlabs"
  ],
  "author": "smjahid012 (SMLabs AI) <https://smlabsai.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smjahid012/serper-search-mcp-server.git"
  },
  "homepage": "https://github.com/smjahid012/serper-search-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/smjahid012/serper-search-mcp-server/issues"
  },
  "files": [
    "dist/",
    "index.js",
    "README.md",
    "LICENSE",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
